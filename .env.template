# Postmark Configuration Template
# Copy this to .env and fill in your values

# Gmail OAuth token (JSON file path)
GMAIL_TOKEN_PATH=/path/to/gmail-token.json

# GCP service account for Pub/Sub
GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-service-account.json
GCP_PROJECT_ID=your-gcp-project
PUBSUB_SUBSCRIPTION=projects/your-project/subscriptions/gmail-sync
PUBSUB_TOPIC=projects/your-project/topics/gmail-events

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cortex
POSTGRES_USER=cortex
POSTGRES_PASSWORD=your-password

# DuckDB API (for services that connect to the API)
DUCKDB_API_URL=http://localhost:8081

# DuckDB local path (for duckdb-api service itself)
DUCKDB_PATH=/path/to/emails.duckdb
